          "id": "cte:InventoryByWarehouse",
          "type": "cte",
          "label": "InventoryByWarehouse",
          "sql": "select i.warehouseid, i.productid, w.warehousename, w.region, i.quantityonhand, i.quantityreserved, i.quantityonhand - i.quantityreserved as availablequantity from ecom.inventory as i inner join ecom.warehouses as w on i.warehouseid = w.warehouseid where i.quantityonhand > 0",
          "layer": 1,
          "columns": [
            "AvailableQuantity",
            "ProductId",
            "Region",
            "WarehouseId",
            "WarehouseName"
          ]
        },
        {
          "id": "cte:PendingShipments",
          "type": "cte",
          "label": "PendingShipments",
          "sql": "select s.shipmentid, s.productid, s.warehouseid, s.requestedquantity, s.shipmentstatus, p.productname, p.unitprice from ecom.shipments as s inner join ecom.products as p on s.productid = p.productid where s.shipmentstatus in ('pending', 'processing')",
          "layer": 1,
          "columns": [
            "ProductId",
            "ProductName",
            "RequestedQuantity",
            "ShipmentId",
            "UnitPrice",
            "WarehouseId"
